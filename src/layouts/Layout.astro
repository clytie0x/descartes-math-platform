---
import { execFileSync } from "node:child_process";
import "katex/dist/katex.min.css";
import "../styles/site.css";
import Nav from "../components/Nav.astro";
import Band from "../components/Band.astro";
import Pager from "../components/Pager.astro";
import { loadSite, type PageNode } from "../lib/site.ts";

interface Props {
  page?: PageNode;
  home?: boolean;
  title?: string;
}

const { page, home = false, title } = Astro.props;
const site = await loadSite();
const { config } = site;
const docTitle = home ? config.name : `${title ?? page?.label ?? ""} - ${config.name}`;

const THAI_MONTHS = ["ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค."];
function lastUpdated(src: string): string {
  try {
    const out = execFileSync("git", ["log", "-1", "--format=%cs", "--", src], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
    if (!out) return "";
    const [y = 0, m = 1, d = 0] = out.split("-").map(Number);
    return `${d} ${THAI_MONTHS[m - 1]} ${y + 543}`;
  } catch {
    return "";
  }
}
const editUrl = page ? `https://github.com/${config.repo}/${page.kind === "exercises" ? "tree" : "edit"}/main/${page.source}` : "";
const updated = page ? lastUpdated(page.source) : "";
---
<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{docTitle}</title>
<meta name="description" content={config.description}>
<script is:inline>try{var t=localStorage.getItem("dc-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);var k=localStorage.getItem("dc-track");if(k==="basic"||k==="adv")document.documentElement.setAttribute("data-track",k)}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anuphan:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&display=swap">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class={home ? "page-home" : undefined}>
<a class="skip" href="#content">ข้ามไปเนื้อหา</a>

<header class="topbar">
  <button type="button" class="icon-btn menu-btn" aria-label="เปิดสารบัญ" aria-controls="sidebar" aria-expanded="false">
    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <a class="brand" href="/">
    <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="1.5" y="1.5" width="29" height="29" rx="7"/><path class="axis" d="M8 23.5h17M8.5 24V7"/><path class="curve" d="M10 9c3 13 9 13 13 0"/><circle class="dot" cx="16.5" cy="18.2" r="2.6"/></svg>
    <span class="brand-name">{config.name}</span>
  </a>
  <span class="topbar-spacer"></span>
  <a class="repo" href={`https://github.com/${config.repo}`} aria-label="ซอร์สบน GitHub">
    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="7" r="2"/><path d="M6 7v10M18 9c0 5-7 4-11 8.5"/></svg>
    <span>{config.repo}</span>
  </a>
  <button type="button" class="icon-btn theme-btn" aria-label="เปลี่ยนเป็นโหมดมืด">
    <svg class="ic i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    <svg class="ic i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</header>

<div class="layout">
  <nav class="sidebar" id="sidebar" aria-label="สารบัญ">
    <div class="drawer-head">
      <span class="drawer-title">สารบัญ</span>
      <button type="button" class="icon-btn drawer-close" aria-label="ปิดสารบัญ">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <Nav current={page} home={home} />
  </nav>
  <div class="scrim" aria-hidden="true"></div>

  <main id="content" class="main">
    {page && <Band page={page} />}
    <article class="doc">
      {page && <h1>{page.label}</h1>}
      {!page && title && <h1>{title}</h1>}
      <slot />
    </article>
    {page && <Pager page={page} />}
  </main>

  <aside class="toc" aria-label="ในหน้านี้">
    <p class="toc-title">ในหน้านี้</p>
    <ul id="toc-list"></ul>
  </aside>
</div>

<footer class="site-footer">
  {page && (
    <p class="page-meta">
      <a href={editUrl}>แก้หน้านี้บน GitHub</a>{updated && `  แก้ล่าสุด ${updated}`}
    </p>
  )}
  <p><span class="wordmark">{config.name}</span> โดย {config.author}</p>
</footer>
<script>
  import "../scripts/site.ts";
</script>
</body>
</html>
