---
/* สัญลักษณ์ของหมวด วงกลม สามเหลี่ยม สี่เหลี่ยม สีมาจาก .topic-* ของตัวแม่ */
interface Props {
  topic: "number" | "shape" | "data";
}
const { topic } = Astro.props;
---
{topic === "number" && <svg class="glyph" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /></svg>}
{topic === "shape" && <svg class="glyph" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3l7.5 13h-15z" /></svg>}
{topic === "data" && <svg class="glyph" viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="1.5" /></svg>}
